# Copy to .env and fill in. NEVER commit the real .env file.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/skill-exchange?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string   # e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
PORT=5000

# Comma-separated list of allowed frontend origins (CORS + Socket.IO)
CLIENT_URL=http://localhost:3000,https://skill-exchangeplatform.vercel.app

# Chatbot (optional). Without a key the bot falls back to a built-in rule-based helper.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Max upload size for chat attachments, in MB
MAX_UPLOAD_MB=10
